# N2 - GHOST IN THE WIRE - environment configuration
# Copy to .env and adjust. All values are optional.

# URL of the competition platform (CTFd) where participants submit flags.
# If set, the portal's "Open submission platform" button links here.
# Leave empty to hide/disable the link.
CTFD_URL=

# Public port the gateway publishes (only used when the gateway profile is on).
PUBLIC_PORT=8080
